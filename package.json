{
  "name": "showtrak-server",
  "productName": "ShowTrak Server",
  "version": "3.13.5",
  "description": "Open source network/device monitoring & control for bulk installations.",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "build:renderer": "node scripts/build-renderer.js",
    "build:css": "node scripts/build-css.js",
    "build:webui": "node scripts/build-webui.js",
    "copy:assets": "node scripts/copy-assets.js",
    "build": "npm run clean && npm run build:ts && npm run typecheck:renderer && npm run build:renderer && npm run build:css && npm run copy:assets && npm run build:webui",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:renderer",
    "start": "nodemon --watch src --watch shared --watch scripts --ignore \"src/UI/css/main.css\" --ext ts,js,mjs,cjs,json,css,html,svg,png,ico --exec \"npm run build && electron-forge start\"",
    "premake": "npm run build",
    "make": "electron-forge make",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{js,mjs,cjs,ts,css,md,json,html}\" --write",
    "format:check": "prettier \"**/*.{js,mjs,cjs,ts,css,md,json,html}\" --check",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1",
    "pretest:coverage": "npm run build",
    "test:coverage": "c8 --all --include=dist/Modules/**/*.js --include=dist/main/**/*.js --reporter=text --reporter=lcov node --test --test-concurrency=1",
    "prepare": "husky",
    "postinstall": "node scripts/copy-bootstrap-icons.js"
  },
  "keywords": [
    "electron",
    "monitoring",
    "lan",
    "arcade",
    "device-management",
    "network-monitoring",
    "client-management",
    "network-discovery",
    "remote-control",
    "script-execution",
    "mdns",
    "bonjour",
    "osc",
    "socket.io",
    "sqlite",
    "wake-on-lan"
  ],
  "author": {
    "name": "ShowTrak",
    "email": "tom@tkw.bz",
    "url": "https://tkw.bz/"
  },
  "contributors": [
    {
      "name": "TKDubsta",
      "email": "tom@tkw.bz"
    }
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShowTrak/ShowTrakServer.git"
  },
  "bugs": {
    "url": "https://github.com/ShowTrak/ShowTrakServer/issues",
    "email": "tom@tkw.bz"
  },
  "homepage": "https://showtrak.co.uk",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^0.13.0",
    "@eslint/markdown": "^8.0.3",
    "@types/express": "^5.0.6",
    "@types/jquery": "^4.0.1",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^26.1.1",
    "bootstrap-icons": "^1.11.3",
    "c8": "^11.0.0",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~5.7",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "bonjour-service": "^1.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "mqtt": "^5.15.2",
    "net-snmp": "^3.26.3",
    "node-osc": "^9.1.7",
    "picocolors": "^1.1.1",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7"
  },
  "overrides": {
    "node-abi": "^3.94.0",
    "ws": "^8.21.0"
  }
}
